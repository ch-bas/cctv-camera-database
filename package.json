    "lint": "node scripts/lint-data.js",
    "coverage": "node scripts/coverage-report.js",
    "archive-sources": "node scripts/archive-sources.js",
    "check-sources": "node scripts/check-sources.js",
    "check-staleness": "node scripts/check-staleness.js",
    "strix-fetch": "node scripts/strix-fetch.js",
    "strix-filter": "node scripts/strix-filter.js",
