{
  "id": "mapesen-w2cq400n-p",
  "brand": "Mapesen",
  "model": "W2CQ400N-P",
  "type": "covert",
  "connectivity": [
    "ethernet"
  ],
  "resolution": {
    "megapixels": 4,
    "max_width": 2560,
    "max_height": 1440,
    "label": "4MP"
  },
  "sensor": "1/2.8\" CMOS",
  "lens": {
    "focal_length_mm": "3.7"
  },
  "night_vision": {
    "min_lux_color": 0.01
  },
  "video": {
    "codecs": [
      "H.265+",
      "H.265",
      "H.264"
    ],
    "max_fps": 25,
    "streams": [
      {
        "name": "main",
        "resolution": "2560x1440",
        "fps": 25,
        "codec": "H.265+"
      }
    ]
  },
  "power_source": [
    "poe",
    "dc"
  ],
  "power": {
    "voltage": "DC 12V",
    "consumption_w": 3
  },
  "protocols": [
    "onvif",
    "rtsp",
    "http"
  ],
  "environment": [
    "indoor"
  ],
  "operating_temp_c": "-10 to 50",
  "network": {
    "ethernet_speed_mbps": 100
  },
  "features": [
    "digital WDR"
  ],
  "configs": {
    "frigate": {
      "onvif_port": 80,
      "verified": false,
      "notes": "Mapesen exposes ONVIF/RTSP but does not publish a fixed RTSP path; use ONVIF auto-config or the camera web UI to obtain the stream URL."
    },
    "home_assistant": {
      "integration": "onvif",
      "notes": "Add via the generic ONVIF integration (port 80)."
    },
    "blue_iris": {
      "profile": "ONVIF",
      "notes": "Use 'Generic/ONVIF' — find/inspect to auto-fill RTSP."
    }
  },
  "sources": [
    "https://www.mapesen.com/covert-camera/w2c-convert-camera-series.html"
  ],
  "last_verified": "2026-09-22",
  "markets": [
    "global"
  ],
  "cloud_dependency": "local"
}
