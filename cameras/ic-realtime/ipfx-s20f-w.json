{
  "id": "ic-realtime-ipfx-s20f-w",
  "brand": "IC Realtime",
  "model": "IPFX-S20F-W",
  "type": "box",
  "resolution": {
    "megapixels": 2,
    "max_width": 1920,
    "max_height": 1080,
    "label": "1080P"
  },
  "sensor": "1/2.8\" CMOS",
  "lens": {
    "count": 1,
    "focal_length_mm": "2.8",
    "aperture": "F2.0",
    "varifocal": false
  },
  "field_of_view_deg": "105(H), 58(V)",
  "video": {
    "codecs": [
      "H.265",
      "H.264"
    ],
    "max_fps": 30
  },
  "night_vision": {
    "type": "color",
    "min_lux_color": 0.005
  },
  "connectivity": [
    "ethernet"
  ],
  "power_source": [
    "poe",
    "dc"
  ],
  "protocols": [
    "rtsp",
    "onvif"
  ],
  "audio": {
    "two_way": true
  },
  "environment": [
    "indoor"
  ],
  "operating_temp_c": "-40 to 60",
  "features": [
    "Missing Object",
    "Face Detection",
    "Fast Moving",
    "Intrusion",
    "Loitering Detection",
    "Perimeter Protection",
    "Tripwire"
  ],
  "sources": [
    "https://www.icrealtime.com/"
  ],
  "last_verified": "2026-09-01",
  "markets": [
    "US"
  ],
  "cloud_dependency": "local",
  "configs": {
    "frigate": {
      "detect": {
        "width": 640,
        "height": 480,
        "fps": 5
      },
      "rtsp_url_template": "rtsp://{user}:{pass}@{ip}:554/cam/realmonitor?channel=1&subtype=0",
      "best_substream": "rtsp://{user}:{pass}@{ip}:554/cam/realmonitor?channel=1&subtype=1",
      "onvif_port": 80,
      "verified": false
    },
    "home_assistant": {
      "integration": "onvif",
      "notes": "Dahua-OEM; use ONVIF or the Dahua/Amcrest integration. Default ONVIF port 80."
    },
    "blue_iris": {
      "profile": "Dahua",
      "notes": "Select Dahua profile — IC Realtime uses Dahua protocol."
    }
  }
}
