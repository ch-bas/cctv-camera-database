{
  "id": "provision-isr-mz-20ipm-2-ir",
  "brand": "Provision-ISR",
  "model": "MZ-20IPM-2(IR)",
  "type": "ptz",
  "connectivity": [
    "ethernet"
  ],
  "resolution": {
    "megapixels": 2,
    "max_width": 1920,
    "max_height": 1080,
    "label": "2MP"
  },
  "lens": {
    "focal_length_mm": "4.9-98",
    "aperture": "F1.6-F3.5",
    "varifocal": true
  },
  "video": {
    "codecs": [
      "H.265"
    ],
    "max_fps": 30
  },
  "night_vision": {
    "type": "ir",
    "range_m": 80
  },
  "protocols": [
    "rtsp",
    "onvif"
  ],
  "environment": [
    "outdoor"
  ],
  "features": [
    "PTZ",
    "20x optical zoom",
    "360° endless pan"
  ],
  "power_source": [
    "dc"
  ],
  "sources": [
    "https://www.provision-isr.com/"
  ],
  "last_verified": "2026-09-01",
  "configs": {
    "frigate": {
      "detect": {
        "width": 640,
        "height": 480,
        "fps": 5
      },
      "rtsp_url_template": "rtsp://{user}:{pass}@{ip}:554/MediaInput/h264/stream_1",
      "best_substream": "rtsp://{user}:{pass}@{ip}:554/MediaInput/h264/stream_2",
      "onvif_port": 80,
      "two_way_audio": false,
      "notes": "Provision-ISR RTSP path is /MediaInput/h264/stream_1 (main) and stream_2 (sub); confirm in the camera web UI."
    },
    "home_assistant": {
      "integration": "onvif",
      "notes": "Add via ONVIF (port 80)."
    },
    "blue_iris": {
      "profile": "ONVIF",
      "notes": "ONVIF or the Provision RTSP URL."
    }
  },
  "ptz": {
    "onvif_ptz": "continuous"
  }
}
